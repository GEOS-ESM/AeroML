#VIIRS_L2A  processing: NNR v3 for NOAA-20 v002
#
# GEOS-FP NRT data stream
#
# L2_DIR: /discover/nobackup/projects/gmao/input/dao_ops/obs/flk/VIIRS/Level2/
#................................................................................

VIIRS_L2A_VERBOSE         = YES

VIIRS_L2A_EXPID           = ${EXPID}
VIIRS_L2A_IDENTS          = vn20dbd,vn20dtl,vn20dto
VIIRS_L2A_COLLECTION      = 002,002,002

VIIRS_L2A_L2_DIR          = ${FVWORK}
VIIRS_L2A_OUT_DIR         = ${FVWORK}

VIIRS_L2A_OVERWRITE       = YES
VIIRS_L2A_OUT_TEMPLATE    = '%s.%prod_L%leva.%algo.%y4%m2%d2_%h2%n2z.%ext'
VIIRS_L2A_RESOLUTION      = e
VIIRS_L2A_NSYN            = 8

VIIRS_L2A_AER_X           = %s.gaas_bkg.sfc.%y4%m2%d2_%h2z.nc4 


VIIRS_L2A_NN_FILE         = ExtData/g5chem/x/NN/nnr_001.%ident.net
VIIRS_L2A_BLANK_ODS       = ExtData/g5chem/x/blank_syn8.ods

VIIRS_L2A_DT_CLD_COLL     = 002
VIIRS_L2A_USE_DT_FILTER   = YES

VIIRS_L2A_CLOUD_THRESH    = 0.1
VIIRS_L2A_CLOUDFREE       = 0.1
VIIRS_L2A_AODMAX          = 2.0
VIIRS_L2A_AODSTD          = 3.0
VIIRS_L2A_AODLENGTH       = 0.5
VIIRS_L2A_WAVS            = 550

#END VIIRS_L2A  processing
